# Database Configuration
# For local PostgreSQL (docker-compose)
POSTGRES_DB=geoserver
POSTGRES_USER=geoserver
POSTGRES_PASSWORD=geoserver
POSTGRES_PORT=5432

# For external database (Cloud SQL, RDS, etc.)
# Uncomment and configure these if using an external database
# DB_HOST=your-cloud-sql-instance-ip
# DB_PORT=5432
# DB_NAME=geoserver
# DB_USER=geoserver
# DB_PASSWORD=your-secure-password
# For GCP Cloud SQL Unix socket connection:
# DB_SOCKET=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# GeoServer Configuration
GEOSERVER_PORT=8080
JAVA_OPTS=-Xms512m -Xmx2048m -Djava.awt.headless=true

# SeaweedFS Configuration (optional overrides)
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333
# ClickHouse query engine (start with: docker compose up -d clickhouse)
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_QUERY_PASSWORD=hifld_query_local_only
CLICKHOUSE_CONTROL_PASSWORD=hifld_control_local_only
DATASET_MCP_CLICKHOUSE_URL=http://127.0.0.1:8123
DATASET_MCP_CLICKHOUSE_USERNAME=hifld_query
DATASET_MCP_CLICKHOUSE_PASSWORD=hifld_query_local_only
DATASET_MCP_CLICKHOUSE_CONTROL_USERNAME=hifld_control
DATASET_MCP_CLICKHOUSE_CONTROL_PASSWORD=hifld_control_local_only
# ClickHouse is inside Compose; use its network address for SeaweedFS sources.
DATASET_MCP_CLICKHOUSE_SEAWEED_ENDPOINT=http://seaweedfs-filer:8333
