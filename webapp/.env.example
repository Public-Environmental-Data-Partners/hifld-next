# Dataset API URL
# Server-side internal dataset API origin
DATASET_API_URL=http://localhost:8000

# Browser-visible dataset API origin served by /runtime-config.js
PUBLIC_DATASET_API_URL=http://localhost:3000

# PostHog Analytics
# Runtime client config served by /runtime-config.js
PUBLIC_POSTHOG_KEY=your_posthog_key_here
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
