# Example environment configuration
# Copy this file to .env.local and modify as needed

# =============================================================================
# API Configuration (Required for FastAPI app)
# =============================================================================

# Database Configuration
# For local development with Docker Compose PostgreSQL:
DATABASE_URL=postgresql://hifld:hifld_dev@localhost:5433/hifld_datasets

# For SQLite (default):
# DATABASE_URL=sqlite:///./local.db

# Enable SQL query logging (useful for debugging):
DATABASE_ECHO=false

# =============================================================================
# Scripts Configuration (Only needed for dataset processing scripts)
# =============================================================================

# Storage Configuration
STORAGE_TYPE=seaweedfs
SEAWEEDFS_FILER_URL=http://localhost:8888
SEAWEEDFS_BUCKET=hifld

# GCS Configuration (if using Google Cloud Storage)
# GCS_BUCKET=your-bucket-name
# GCS_PROJECT=your-project-id
