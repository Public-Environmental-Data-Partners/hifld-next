# Source this file from a shell to run host-based consumers against local output.
# These are deliberately local-only credentials; never use this file for production.
export HIFLD_STAGING_BACKEND=s3
export HIFLD_STAGING_BUCKET=hifld-local-staging
export HIFLD_STAGING_S3_ENDPOINT=http://localhost:8333
export HIFLD_STAGING_S3_ACCESS_KEY=dummy
export HIFLD_STAGING_S3_SECRET_KEY=dummy
export HIFLD_DATASETS_BACKEND=s3
export HIFLD_DATASETS_BUCKET=hifld-local-published
export HIFLD_DATASETS_S3_ENDPOINT=http://localhost:8333
export HIFLD_DATASETS_S3_ACCESS_KEY=dummy
export HIFLD_DATASETS_S3_SECRET_KEY=dummy
export CATALOG_SQLITE_URL=http://localhost:8333/hifld-local-published/_catalog/catalog.sqlite
export CATALOG_REFRESH_INTERVAL_MS=2000
export CATALOG_STORAGE_LOCATIONS_JSON='{"seaweedfs-local-published":{"type":"seaweedfs","base_url":"http://localhost:8333","endpoint_url":"http://localhost:8333","bucket":"hifld-local-published"}}'
export FEATURE_SERVER_CATALOG_URL=http://localhost:8333/hifld-local-published/_catalog/catalog.sqlite
export FEATURE_SERVER_CATALOG_POLL_SECONDS=2
export FEATURE_SERVER_STORAGE_LOCATIONS='{"seaweedfs-local-published":{"type":"seaweedfs","bucket":"hifld-local-published","prefix":"hifld","endpoint_url":"http://localhost:8333"}}'
export FEATURE_SERVER_PUBLIC_URL=http://localhost:8003
export S3_ACCESS_KEY_ID=dummy
export S3_SECRET_ACCESS_KEY=dummy
# The legacy service is intentionally unavailable for catalog smoke testing.
export DATASET_API_URL=http://127.0.0.1:8999
# Run the current query service locally, independent of deployed port forwards.
export DATASET_MCP_CATALOG_BASE_URL=http://127.0.0.1:3000
export DATASET_MCP_CATALOG_STORAGE_LOCATIONS="$CATALOG_STORAGE_LOCATIONS_JSON"
export DATASET_MCP_QUERY_API_URL=http://127.0.0.1:8004
export DATASET_MCP_PUBLIC_ENDPOINT=http://127.0.0.1:8004/mcp
export DATASET_MCP_PUBLIC_ORIGIN=http://127.0.0.1:8004
export DATASET_MCP_QUERY_TOKEN_SECRET=local-only-portolan-query-secret-not-for-production
export DATASET_MCP_DUCKDB_EXTENSION_DIRECTORY=/private/tmp/hifld-local-query-extensions
export DATASET_MCP_DUCKDB_TEMP_DIRECTORY=/private/tmp/hifld-local-query-temp
export DATASET_MCP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost
export DATASET_MCP_WEBAPP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
