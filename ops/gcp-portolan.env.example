# Host-based consumer configuration for the public GCP Portolan catalog.
# The published bucket is read-only for these consumers. Do not add credentials.
# Keep both storage slugs while the migrated catalog and new shadow publications coexist.

export HIFLD_STAGING_BACKEND=gcs
export HIFLD_STAGING_BUCKET=hifld-next-portolan-staging
export HIFLD_STAGING_S3_ENDPOINT=https://storage.googleapis.com
export HIFLD_DATASETS_BACKEND=gcs
export HIFLD_DATASETS_BUCKET=hifld-next-portolan-published
export HIFLD_DATASETS_S3_ENDPOINT=https://storage.googleapis.com

export CATALOG_SQLITE_URL=https://storage.googleapis.com/hifld-next-portolan-published/_catalog/catalog.sqlite
export CATALOG_REFRESH_INTERVAL_MS=30000
export CATALOG_STORAGE_LOCATIONS_JSON='{"gcp-portolan-published":{"type":"gcs","base_url":"https://storage.googleapis.com/hifld-next-portolan-published","bucket":"hifld-next-portolan-published"},"gcs-portolan-published":{"type":"gcs","base_url":"https://storage.googleapis.com/hifld-next-portolan-published","bucket":"hifld-next-portolan-published"}}'

export FEATURE_SERVER_CATALOG_URL="$CATALOG_SQLITE_URL"
export FEATURE_SERVER_CATALOG_POLL_SECONDS=30
export FEATURE_SERVER_STORAGE_LOCATIONS='{"gcp-portolan-published":{"type":"gcs","bucket":"hifld-next-portolan-published","prefix":"hifld"},"gcs-portolan-published":{"type":"gcs","bucket":"hifld-next-portolan-published","prefix":"hifld"}}'
export FEATURE_SERVER_PUBLIC_URL=http://127.0.0.1:8003

# Keep the local SeaweedFS path available through ops/local-portolan.env.example.
# These write-bucket variables are intentionally separate from the read-only
# published bucket above; this file does not configure upload or promotion jobs.
export HIFLD_STAGING_WRITE_BUCKET=hifld-next-portolan-staging
export HIFLD_PUBLISHED_READ_BUCKET=hifld-next-portolan-published

export DATASET_API_URL=http://127.0.0.1:8999
export DATASET_MCP_CATALOG_BASE_URL=http://127.0.0.1:3000
export DATASET_MCP_CATALOG_STORAGE_LOCATIONS="$CATALOG_STORAGE_LOCATIONS_JSON"
export DATASET_MCP_CLICKHOUSE_URL=http://127.0.0.1:8123
export DATASET_MCP_CLICKHOUSE_USERNAME=hifld_query
export DATASET_MCP_CLICKHOUSE_PASSWORD=hifld_query_local_only
export DATASET_MCP_CLICKHOUSE_CONTROL_USERNAME=hifld_control
export DATASET_MCP_CLICKHOUSE_CONTROL_PASSWORD=hifld_control_local_only
export DATASET_MCP_CLICKHOUSE_SEAWEED_ENDPOINT=http://seaweedfs-filer:8333
export DATASET_MCP_QUERY_API_URL=http://127.0.0.1:8004
export DATASET_MCP_PUBLIC_ENDPOINT=http://127.0.0.1:8004/mcp
export DATASET_MCP_PUBLIC_ORIGIN=http://127.0.0.1:8004
export DATASET_MCP_QUERY_TOKEN_SECRET=local-only-portolan-query-secret-not-for-production
export DATASET_MCP_DUCKDB_EXTENSION_DIRECTORY=/private/tmp/hifld-gcp-query-extensions
export DATASET_MCP_DUCKDB_TEMP_DIRECTORY=/private/tmp/hifld-gcp-query-temp
export DATASET_MCP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost
export DATASET_MCP_WEBAPP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
